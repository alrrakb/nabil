{
  "buildCommand": "pnpm --filter @workspace/api-server build && pnpm --filter @workspace/correspondence build",
  "outputDirectory": "artifacts/correspondence/dist/public",
  "functions": {
    "api/index.js": {
      "includeFiles": "artifacts/api-server/dist/**",
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api" }
  ]
}
